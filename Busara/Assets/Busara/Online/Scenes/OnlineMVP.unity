MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 732064464}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6f7e44d7c08b49a3a7c7330bc48d7ea1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Busara.Online.Client::Busara.Online.Client.OnlineMvpScreen
  resourceIcons:
  - {fileID: 21300000, guid: b8747fb961edcd2cd5dac50033e2839a, type: 3}
  - {fileID: 21300000, guid: a4af45c4ae8561639f80c24fa55ee9d5, type: 3}
  - {fileID: 21300000, guid: 62742e2254aa290ecc1d39e7a157d695, type: 3}
  - {fileID: 21300000, guid: 71100e26458a4a86c195ff0a979dd184, type: 3}
  virtueIcons:
  - {fileID: 21300000, guid: 54debe85dc4deb54c96a7525944f0cea, type: 3}
  - {fileID: 21300000, guid: 6716b022f2e7b704d96bea4bf45b1aae, type: 3}
  - {fileID: 21300000, guid: afcfff6b932f5724094f40bd60c66d9c, type: 3}
  - {fileID: 21300000, guid: 7e21f0cab2eb0394f91035b0f212161c, type: 3}
  - {fileID: 21300000, guid: e71bac00b2debe94ea2679fffc9ad6c4, type: 3}
  - {fileID: 21300000, guid: 8b9f3e3050c1ebb4b911734134d048c0, type: 3}
  kingdomTexts:
  - id: aradas
    name: "The Aradas"
    story: "The Aradas are the people of omniscience. They are origins of humanity so they identify themselves with all that is out there which makes them unidentifiable. They are everyone and no one at the same time. They surf through identities because they know identities are abstractions of the human mind."
    power: "Exchange your Kingdom Card with another player."
  - id: bis-bese-avouman
    name: "Bis-Bese Avouman"
    story: "King Samba, a descendant of Nyong, rules Bis-Bese Avouman. Nyong's spirit chooses the kingdom's leader, and its rivers reveal the kingdom's secrets."
    power: "Pay 3 Virtues when another player uses a Power to cancel its effects. That player still pays the Power's cost."
  - id: egolica
    name: "Egolica"
    story: "Egolica shares its gold wealth equally among citizens through a universal basic income. The kingdom values unity, security, happiness and environmental sustainability."
    power: "Free and usable only while your Kingdom Card is hidden. Reveal it and add a number of Resources equal to the player count. This Power can be used only once per game."
  - id: eko-akete
    name: "Eko Akete"
    story: "The system of governance is described as UMUNNA, a republican system of government where everyone comes together to reach an agreement on a common goal. The Kingdom values Creativity, Justice, Industriousness, and most of all oneness."
    power: "Discard any number of Virtues. Take that many Virtues of a single type from the stockpile."
  - id: empire-volta
    name: "Empire Volta"
    story: "Volta brings together ethnic groups in Africa through shared knowledge, traditions, magic and technology. Nakomean warriors govern using the Volta Stones of Power."
    power: "Pay 1 Virtue when an attack targets you or you draw a disaster to cancel that attack or disaster. This does not block Powers."
  - id: ilagik
    name: "ILAGIK"
    story: "The ILAGIK Kingdom dates back centuries ago in Rwanda, Between 10th and 17th century. It is known for its interesting places and king Ruganzu, famous for being a warrior, conqueror and mostly for having super powers, the reason he was known as the King of Miracles."
    power: "Rearrange your Resources within your kingdom."
  - id: kavango-keendobe
    name: "Kavango Keendobe"
    story: "This northern Namibian monarchy in the Omusati Region unites seven tribes under the elder Mukwanangobe. It values authority and business management, and uses Amarula trees to make cosmetics."
    power: "Pay 3 Virtues and choose to add or remove 1, 2, or 3 Resources. Every player performs that operation with that quantity on their own board, choosing the Resource types themselves."
  - id: konga
    name: "Konga"
    story: "Founded in the nineteenth century, Konga is ruled by King Sekou and Queen Pokou. Advisers and military leaders support a kingdom known for military trade, its powerful army and territorial conquests."
    power: "Pay 2 Virtues to take two actions this turn rather than one."
  - id: logone
    name: "Logone"
    story: "Logone is a coastal kingdom located in West Africa. It is led by the great king Dzitri and his council of wise men. The wealth of this kingdom comes mainly from fishing, agriculture and iron work. This kingdom is covered in many lagoons."
    power: "Pay 4 Virtues to double each Resource type currently on your Kingdom Board."
  - id: mask-of-light
    name: "Mask of Light"
    story: "Baye rules the intuitive protectors of the Mask of Light. Their magical henna markings glow before sunset and record the good decisions they have made."
    power: "Pay 2 Virtues during another player's turn to undo that player's move. Play then proceeds to the player who would normally have gone next."
  - id: milu
    name: "Milu"
    story: "The kingdom is ruled by a woman who is strong and powerful. She governs with a democratic system in which the power is spread and belongs to the people in order to increase impact, effectiveness and credibility and guarantee development. And the queen is actually a simple woman, deeply rooted in her culture and traditions, but also very curious of the world."
    power: "Hide your Virtues from other players for the remainder of the game by placing them under your Kingdom Card, and steal one Resource from any player of your choice. (Your Kingdom Card remains face up)"
  - id: nevulandis
    name: "N'evulandis"
    story: "N'Evulandis, pronounced 'Neverlandis', is a futuristic civilization in the 30th century governed by the House of IO's, sort of a monarchy. The people are called N'evula, they speak Lota and use Data as currency. Their house values are Peace, Information, Loyalty and Collaboration."
    power: "Another player of your choice must show you their Kingdom Card."
  - id: royaume-kongo
    name: "Royaume Kongo"
    story: "In this kingdom the power is maintained by a Lumumba in Mani Kongo (the supreme leader) and its capital is Mbanza Ngungu. Among its peculiarities, the kingdom is a center of Cultural Revolution, with a great sense of taste, beautiful and art. Royaume Konga dominated all the other kingdoms during its heyday and its influence reached all the way to the northern hemisphere."
    power: "Use this Power only when another player is about to start their turn. Take their turn for them instead, choosing an action for them. You may not use this power to force them to trade."
  - id: telalila
    name: "Telalila"
    story: "Telalila is an ancient East African kingdom whose existence has long been disputed. Its name means The Play of God, its government has three strata, and animism shapes its values."
    power: "Pay 2 Virtues during another player's turn to take an extra turn immediately after theirs. The normal turn order resumes after your extra turn."
  - id: ubunifu
    name: "Ubunifu"
    story: "\"Ubunifu\" means Creativity and Imagination in Swahili. The kingdom is ruled by an elite council. It began in the 22nd century after a long war of minds and skills. The people are Craftsmen of all sorts & skilled Juju men who developed hyper neural activity hence ability to read and translate thoughts."
    power: "Take one Virtue of your choice from another player of your choice."
  session: {fileID: 732064466}
  browser: {fileID: 732064467}
  entryPage: {fileID: 244871577}
  lobbyPage: {fileID: 317807040}
  matchPage: {fileID: 665505913}
  statusText: {fileID: 1349875309}
  connectionText: {fileID: 915578072}
